# ============================================================
#  إعدادات نظام أتمتة السوشيال ميديا — انسخ هذا الملف إلى .env
#  ثم املأ القيم. اترك أي قيمة فارغة ليعمل النظام في وضع تجريبي (Mock).
# ============================================================

# ---- وضع التشغيل ----
# mock  = لا نشر حقيقي ولا استدعاء AI مدفوع (للتجربة الآمنة)
# live  = نشر حقيقي واستدعاء AI فعلي (يتطلب المفاتيح أدناه)
APP_MODE=mock

# ---- قاعدة البيانات (SQLite افتراضيًا — لا تحتاج تنصيب شيء) ----
DATABASE_URL=sqlite:///./data/social.db

# ---- Meta / Facebook + Instagram (لكل علامة يُملأ لاحقًا في لوحة التحكم) ----
META_APP_ID=
META_APP_SECRET=

# ---- توليد النصوص ----
ANTHROPIC_API_KEY=
# أو
OPENAI_API_KEY=

# ---- توليد الصور ----
IMAGE_API_KEY=

# ---- توليد/تحليل الرؤية (Vision) ----
VISION_API_KEY=

# ---- تخزين الوسائط العام (مطلوب لإنستغرام في وضع live) ----
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ---- الخادم ----
HOST=127.0.0.1
PORT=8000
